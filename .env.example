# Local Knots JSON-RPC (gitignored as .env). Never commit real credentials.
# npm start syncs these into blaketime.local.json + secrets/rpc-password.
RPC_HOST=https://snowy-sip.local:57747
RPC_USER=
RPC_PASS=
# Optional:
# RPC_NETWORK=main
# RPC_LABEL=StartOS Knots
# StartOS LAN certs may fail rustls key-size checks even when OpenSSL/curl trust them.
# RPC_TLS_INSECURE=1
