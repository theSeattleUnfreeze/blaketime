{
  "name": "blaketime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "types:generate": "node scripts/contracts.mjs --write",
    "types:check": "node scripts/contracts.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages/ui tests e2e scripts",
    "test": "vitest run",
    "build:ui": "npm run types:check && npm run build --workspace @blaketime/ui",
    "build:web": "cargo build --release --locked -p blaketime-web",
    "test:e2e": "playwright test",
    "start": "node scripts/start-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
